# --- IA ---
GEMINI_API_KEY=
RAWG_API_KEY=
####
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
PAIS_PRECIOS=CL
####
ITAD_API_KEY=
# --- Base de datos MySQL ---
# formato: mysql+pymysql://USUARIO:CLAVE@HOST:PUERTO/NOMBRE_BD
DATABASE_URL=

# --- Seguridad ---
# Texto largo y aleatorio. Genera uno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRA_HORAS=24

# --- Correo para verificar cuentas (Gmail) ---
# Cuenta de Gmail que ENVÍA los códigos y su "contraseña de aplicación"
# (16 letras, NO la contraseña normal). Ver INSTALACION.md, paso 6.
# Si SMTP_USUARIO queda vacío, el código se muestra en la consola del servidor.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
# --- Servidor ---
PORT=5000
DEBUG_MODE=0


# --- Parámetros RAG ---
UMBRAL_DISTANCIA_MAXIMA=0.148
